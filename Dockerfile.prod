FROM node:22-alpine AS builder

WORKDIR /app

# NEXT_PUBLIC_* values are INLINED into the bundle at build time, which is why
# they are build args and not runtime environment.
#
# The API URL defaults to EMPTY on purpose. One image serves every tenant, so a
# baked-in address pins the whole platform to one company — it used to carry a
# hard-coded IP, which meant every shop's till called that one server whatever
# subdomain it was opened on. Left empty, the client reads the API off
# `window.location`, so `nusrat.sortpi.com` calls `nusrat.sortpi.com`.
#
# The port is empty for the same reason: 8000 is a development convenience, and
# behind nginx the API answers on the page's own port.
ARG NEXT_PUBLIC_API_URL=""
ARG NEXT_PUBLIC_API_PORT=""
ARG NEXT_PUBLIC_PLATFORM_BASE_DOMAIN=""
ARG NEXT_PUBLIC_PLATFORM_HOSTS=""
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_PORT=$NEXT_PUBLIC_API_PORT
ENV NEXT_PUBLIC_PLATFORM_BASE_DOMAIN=$NEXT_PUBLIC_PLATFORM_BASE_DOMAIN
ENV NEXT_PUBLIC_PLATFORM_HOSTS=$NEXT_PUBLIC_PLATFORM_HOSTS

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3500
ENV HOSTNAME="0.0.0.0"

COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/package-lock.json ./package-lock.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public

EXPOSE 3500

CMD ["npm", "run", "start"]
